    "@angular/language-service": "^20.3.0",
    "@babel/core": "^7.11.6",
    "@compodoc/compodoc": "1.1.30",
    "@marklb/storybook-angular-initial-url": "^2.0.0",
    "@ngneat/spectator": "^18.0.2",
    "@storybook/addon-docs": "^9.1.6",
    "@storybook/addon-a11y": "^9.1.6",
    "@storybook/addon-jest": "^9.1.6",
    "@storybook/addon-links": "^9.1.6",
    "@storybook/angular": "^9.1.6",
    "@storybook/test-runner": "^0.23.0",
    "@testing-library/angular": "^18.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/file-saver": "^2.0.1",
    "@types/geojson": "^7946.0.10",
    "@types/google.maps": "^3.52.5",
    "@types/intl-tel-input": "^17.0.1",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.12.0",
    "@types/overlayscrollbars": "~1.7.0",
    "@types/pdfjs-dist": "^2.7.1",
    "@types/react": "^18.2.23",
    "@types/react-dom": "^18.2.8",
    "@types/shpjs": "^3.4.1",
    "@types/webfontloader": "^1.6.29",
    "@types/webpack-env": "^1.13.7",
    "@typescript-eslint/eslint-plugin": "5.48.2",
    "@typescript-eslint/parser": "5.48.2",
    "babel-loader": "^8.1.0",
    "babel-preset-env": "^1.7.0",
