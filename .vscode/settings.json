{
  // Set the default
  "editor.formatOnSave": true,
  // Enable per-language
  "[javascript]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[scss]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[markdown]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },

  // Makes sure we use the dependent typescript version.
  // --------------------------------------------------------------------------
  // NOTE: In the workspace settings this doesn't actually do anything other
  //  than indicate which Typescript you are using. It is a security issue for
  //  VSCode to execute arbitrary code without the user confirming it. I
  //  understand the reason, but still find it wrong that VSCode doesn't tell me,
  //  because I usually spend way to long trying to fix problems, that make no
  //  sense, every time I open a project for the first time.
  //
  //  Example of reason: User clones git repo, with `{ "typescript.tsdk":
  //  "./delete-system32.js" }` in the `.vscode/settings.json`. Once they open
  //  VSCode, they would be in trouble.
  "typescript.tsdk": "node_modules/typescript/lib",

  "jest.autoRun": "off",
  "jest.jestCommandLine": "npm run test -- --no-cache",
  "js/ts.tsdk.path": "node_modules/typescript/lib"


  // Our custom schematics.
  // "ngschematics.schematics": [
  //   // '@theseam/ui-common' schematics.
  //   "./dist/ui-common/schematics/collection.json"
  // ]
}
